36571>>>>>>>    //
36571>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36571>>>>>>>    //
36571>>>>>>>    //  Params:
36571>>>>>>>    //      dtTime  Time to convert
36571>>>>>>>    //  Returns:
36571>>>>>>>    //      String with "HH:MM:SS" format
36571>>>>>>>    //
36571>>>>>>>    Function TimeToString DateTime dtTime Returns String
36573>>>>>>>        String sHours sMinutes sSeconds
36573>>>>>>>        
36573>>>>>>>        //  Extract parts
36573>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36574>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36575>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36576>>>>>>>        
36576>>>>>>>        //  Fill out with 0
36576>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36579>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36582>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36585>>>>>>>        
36585>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36586>>>>>>>    End_Function
36587>>>>>>>    
36587>>>>>>>    //
36587>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36587>>>>>>>    //
36587>>>>>>>    //  Params:
36587>>>>>>>    //      dtTime  Datetime variable to add time to
36587>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36587>>>>>>>    //  Returns:
36587>>>>>>>    //      dtDateTime with the loaded time
36587>>>>>>>    //
36587>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36589>>>>>>>        String sHours sMinutes sSeconds
36589>>>>>>>        
36589>>>>>>>        //  Extract parts
36589>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36590>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36591>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36592>>>>>>>        
36592>>>>>>>        //  Set to DateTime
36592>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36593>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36594>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36595>>>>>>>        
36595>>>>>>>        Function_Return dtTime
36596>>>>>>>    End_Function
