36885>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36886>>>>>    
36886>>>>>    Procedure Construct_Object
36888>>>>>        Handle hoObj
36888>>>>>        
36888>>>>>        Forward Send Construct_Object
36890>>>>>        
36890>>>>>        Set pbSessionCookieHttpOnly to True
36891>>>>>        
36891>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36892>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36893>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36894>>>>>        
36894>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36895>>>>>        Set phoUserDD to hoObj
36896>>>>>        
36896>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36897>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36898>>>>>        Set phoSessionDD to hoObj
36899>>>>>        
36899>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36900>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36901>>>>>        Set phoCrypto to hoObj
36902>>>>>        
36902>>>>>        Property Boolean pbPasswordHashing True
36903>>>>>        
36903>>>>>        Property Boolean pbCreatingNewSession False
36904>>>>>        Property String psLoginName
36905>>>>>        Property String psUserName ""
36906>>>>>        Property Integer piUserRights 0
36907>>>>>    End_Procedure
36908>>>>>    
36908>>>>>    Procedure End_Construct_Object
36910>>>>>        Forward Send End_Construct_Object
36912>>>>>        
36912>>>>>        Handle hoCrypto
36912>>>>>        Integer iFieldLen
36912>>>>>        If (pbPasswordHashing(Self)) Begin
36914>>>>>            Get phoCrypto to hoCrypto
36915>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36918>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36920>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36921>>>>>>
36921>>>>>            End
36921>>>>>>
36921>>>>>        End
36921>>>>>>
36921>>>>>    End_Procedure
36922>>>>>    
36922>>>>>    Function CreateSession String sRemoteAddress Returns String
36924>>>>>        String sSessionKey
36924>>>>>        Integer iErr
36924>>>>>        Boolean bLogWebSession
36924>>>>>        Handle hoSessionDD       
36924>>>>>        Get phoSessionDD to hoSessionDD
36925>>>>>        
36925>>>>>        //  Get session key
36925>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36927>>>>>        
36927>>>>>        Get pbLogWebSession to bLogWebSession
36928>>>>>        If not bLogWebSession Begin
36930>>>>>            Function_Return sSessionKey        
36931>>>>>        End
36931>>>>>>
36931>>>>>
36931>>>>>        //  Store session
36931>>>>>        Send Clear of hoSessionDD
36932>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36933>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36934>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36935>>>>>        Get Request_Validate of hoSessionDD to iErr
36936>>>>>        If (iErr) Begin
36938>>>>>            // this should not happen. If it does its a programming error
36938>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36939>>>>>>
36939>>>>>            Function_Return ""
36940>>>>>        End
36940>>>>>>
36940>>>>>        Send Request_Save of hoSessionDD
36941>>>>>        If (Err) Begin
36943>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36943>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36944>>>>>>
36944>>>>>            Function_Return ""
36945>>>>>        End
36945>>>>>>
36945>>>>>       
36945>>>>>        Function_Return sSessionKey        
36946>>>>>    End_Function
36947>>>>>    
36947>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36949>>>>>        DateTime dtLastAccess dtCurrent
36949>>>>>        TimeSpan tsDiff
36949>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36949>>>>>        Boolean bResult bCreatingNewSession
36949>>>>>        Boolean bLogWebSession bLoadWebApp
36949>>>>>        Integer eLoginMode
36949>>>>>        String sTime
36949>>>>>        Handle hoSessionDD hoUserDD       
36949>>>>>        
36949>>>>>        Move False to bLoadWebApp
36950>>>>>        If (num_arguments >= 2) Begin
36952>>>>>            Move bOptLoadWebApp to bLoadWebApp
36953>>>>>        End
36953>>>>>>
36953>>>>>        
36953>>>>>        Get phoSessionDD to hoSessionDD
36954>>>>>        Get phoUserDD to hoUserDD
36955>>>>>        
36955>>>>>        Get pbLogWebSession to bLogWebSession
36956>>>>>        Get peLoginMode to eLoginMode
36957>>>>>        
36957>>>>>        // for this object, you can only disable logging if login completely is disabled
36957>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36959>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36960>>>>>>
36960>>>>>            Function_Return False
36961>>>>>        End
36961>>>>>>
36961>>>>>
36961>>>>>        //  Clear session properties
36961>>>>>        Set psSessionKey to ""
36962>>>>>        Send UpdateSessionProperties True
36963>>>>>        
36963>>>>>        If not bLogWebSession Begin
36965>>>>>            Forward Get ValidateSession sSessionKey to bResult
36967>>>>>            Function_Return bResult
36968>>>>>        End        
36968>>>>>>
36968>>>>>        
36968>>>>>        Move False to bResult
36969>>>>>        Get piSessionTimeout to iSessionTimeout 
36970>>>>>        
36970>>>>>        //  Check if session exists
36970>>>>>        Send Clear of hoSessionDD
36971>>>>>        Move sSessionKey to WebAppSession.SessionKey
36972>>>>>        Send Find of hoSessionDD EQ Index.1
36973>>>>>            
36973>>>>>        If (Found) Begin
36975>>>>>            //  Calculate timespan between now and last access time
36975>>>>>            Move (CurrentDateTime()) to dtCurrent
36976>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36977>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36978>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36979>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36980>>>>>            
36980>>>>>            //  Check if session didn't time out
36980>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36982>>>>>                Forward Get ValidateSession sSessionKey to bResult
36984>>>>>                   
36984>>>>>                If (bResult) Begin
36986>>>>>                    //  Update session record
36986>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36987>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36988>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36989>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36990>>>>>                    Get Request_Validate of hoSessionDD to iErr
36991>>>>>                    If (iErr) Begin
36993>>>>>                        // this should not happen. If it does its a programming error
36993>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36994>>>>>>
36994>>>>>                        Function_Return False
36995>>>>>                    End
36995>>>>>>
36995>>>>>                    Send Request_Save of hoSessionDD
36996>>>>>                    
36996>>>>>                    //  Update user properties
36996>>>>>                    Send UpdateSessionProperties False
36997>>>>>                End
36997>>>>>>
36997>>>>>            End
36997>>>>>>
36997>>>>>            Else Begin
36998>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36998>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36999>>>>>                
36999>>>>>                If (not(bCreatingNewSession)) Begin
37001>>>>>                    If (not(bLoadWebApp)) Begin
37003>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37004>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37005>>>>>>
37005>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37006>>>>>                    End
37006>>>>>>
37006>>>>>                    Else Begin
37007>>>>>                        Set pbCreatingNewSession to True                    
37008>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37009>>>>>                        Set pbCreatingNewSession to False                        
37010>>>>>                    End
37010>>>>>>
37010>>>>>                End
37010>>>>>>
37010>>>>>            End
37010>>>>>>
37010>>>>>        End
37010>>>>>>
37010>>>>>        Else Begin
37011>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37012>>>>>>
37012>>>>>        End
37012>>>>>>
37012>>>>>        
37012>>>>>        Function_Return bResult
37013>>>>>    End_Function
37014>>>>>    
37014>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37016>>>>>        If (not(pbPasswordHashing(Self))) Begin
37018>>>>>            Move sPassword to sHash
37019>>>>>            Function_Return True
37020>>>>>        End
37020>>>>>>
37020>>>>>        
37020>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37022>>>>>            Function_Return False
37023>>>>>        End
37023>>>>>>
37023>>>>>        Move ("V1$" + sHash) to sHash
37024>>>>>        Function_Return True
37025>>>>>    End_Function
37026>>>>>    
37026>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37028>>>>>        If (not(pbPasswordHashing(Self))) Begin
37030>>>>>            Move False to bShouldUpgrade
37031>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37032>>>>>        End
37032>>>>>>
37032>>>>>        
37032>>>>>        String sVersion
37032>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37033>>>>>        If (sVersion = "V1$") Begin
37035>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37038>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37039>>>>>        End
37039>>>>>>
37039>>>>>        Else Begin
37040>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37043>>>>>            Function_Return False
37044>>>>>        End
37044>>>>>>
37044>>>>>    End_Function
37045>>>>>    
37045>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37047>>>>>        Handle hoUserDD
37047>>>>>        Integer iErr
37047>>>>>        Get phoUserDD to hoUserDD
37048>>>>>        
37048>>>>>        //  Find the user
37048>>>>>        Send Clear of hoUserDD
37049>>>>>        Move sLoginName to WebAppUser.LoginName
37050>>>>>        Send Find of hoUserDD EQ Index.1
37051>>>>>        If (Found) Begin
37053>>>>>            Send Clear of hoUserDD
37054>>>>>            Function_Return False
37055>>>>>        End
37055>>>>>>
37055>>>>>        
37055>>>>>        Send Clear of hoUserDD
37056>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37057>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37058>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37060>>>>>            Send Clear of hoUserDD
37061>>>>>            Function_Return False
37062>>>>>        End
37062>>>>>>
37062>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37063>>>>>        Get Request_Validate of hoUserDD to iErr
37064>>>>>        If (iErr) Begin
37066>>>>>            Send Clear of hoUserDD
37067>>>>>            Function_Return False
37068>>>>>        End
37068>>>>>>
37068>>>>>        
37068>>>>>        Send Request_Save of hoUserDD
37069>>>>>        Function_Return (not(Err))
37070>>>>>    End_Function
37071>>>>>    
37071>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37073>>>>>        String sSessionKey sUserPassword
37073>>>>>        Handle hoSessionDD hoUserDD
37073>>>>>        Boolean bMatch bUpgrade
37073>>>>>        
37073>>>>>        Get phoSessionDD to hoSessionDD
37074>>>>>        Get phoUserDD to hoUserDD
37075>>>>>        Integer iErr eLoginMode
37075>>>>>        
37075>>>>>        // Refind session record
37075>>>>>        Get psSessionKey to sSessionKey
37076>>>>>        Send Clear of hoSessionDD
37077>>>>>        Move sSessionKey to WebAppSession.SessionKey
37078>>>>>        Send Find of hoSessionDD EQ Index.1
37079>>>>>        
37079>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37081>>>>>            Get peLoginMode to eLoginMode
37082>>>>>            
37082>>>>>            //  Find the user
37082>>>>>            Move sLoginName to WebAppUser.LoginName
37083>>>>>            Send Find of hoUserDD EQ Index.1
37084>>>>>            
37084>>>>>            // Check username and password
37084>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37086>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37087>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37088>>>>>                
37088>>>>>                If (bMatch) Begin
37090>>>>>                    // Store the login
37090>>>>>                    If (bUpgrade) Begin
37092>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37093>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37096>>>>>                    End
37096>>>>>>
37096>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37097>>>>>                    Get Request_Validate of hoSessionDD to iErr
37098>>>>>                    If (iErr) Begin
37100>>>>>                        // this should not happen. If it does its a programming error
37100>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37101>>>>>>
37101>>>>>                        Function_Return False
37102>>>>>                    End
37102>>>>>>
37102>>>>>                    
37102>>>>>                    Send Request_Save of hoSessionDD
37103>>>>>                    
37103>>>>>                    // Update session properties
37103>>>>>                    Send UpdateSessionProperties False
37104>>>>>                    Send NotifyChangeRights
37105>>>>>                    Function_Return True
37106>>>>>                End
37106>>>>>>
37106>>>>>                Else Begin
37107>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37107>>>>>                    Send Clear of hoUserDD
37108>>>>>                End
37108>>>>>>
37108>>>>>            End
37108>>>>>>
37108>>>>>            Else Begin
37109>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37109>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37110>>>>>            End
37110>>>>>>
37110>>>>>        End
37110>>>>>>
37110>>>>>        Else Begin
37111>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37111>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37112>>>>>        End
37112>>>>>>
37112>>>>>          
37112>>>>>        Function_Return False
37113>>>>>    End_Function
37114>>>>>    
37114>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37116>>>>>        Handle hoUserDD
37116>>>>>        Integer iErr
37116>>>>>        Get phoUserDD to hoUserDD
37117>>>>>        
37117>>>>>        //  Find the user
37117>>>>>        Send Clear of hoUserDD
37118>>>>>        Move sLoginName to WebAppUser.LoginName
37119>>>>>        Send Find of hoUserDD EQ Index.1
37120>>>>>        If (not(Found)) Begin
37122>>>>>            Send Clear of hoUserDD
37123>>>>>            Function_Return False
37124>>>>>        End
37124>>>>>>
37124>>>>>        
37124>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37126>>>>>            Send Clear of hoUserDD
37127>>>>>            Function_Return False
37128>>>>>        End
37128>>>>>>
37128>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37129>>>>>        Get Request_Validate of hoUserDD to iErr
37130>>>>>        If (iErr) Begin
37132>>>>>            Send Clear of hoUserDD
37133>>>>>            Function_Return False
37134>>>>>        End
37134>>>>>>
37134>>>>>        
37134>>>>>        Send Request_Save of hoUserDD
37135>>>>>        Function_Return (not(Err))
37136>>>>>    End_Function
37137>>>>>    
37137>>>>>    Function IsLoggedIn Returns Boolean
37139>>>>>        String sLoginName
37139>>>>>        Boolean bLogWebSession bLoggedIn
37139>>>>>        
37139>>>>>        Get pbLogWebSession to bLogWebSession
37140>>>>>        If not bLogWebSession Begin
37142>>>>>            Forward Get IsLoggedIn to bLoggedIn
37144>>>>>            Function_Return bLoggedIn
37145>>>>>        End
37145>>>>>>
37145>>>>>        
37145>>>>>        Get psLoginName to sLoginName
37146>>>>>        
37146>>>>>        Function_Return (sLoginName <> "")
37147>>>>>    End_Function
37148>>>>>    
37148>>>>>    
37148>>>>>    //
37148>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37148>>>>>    // update properties based on the session and user data. Augment this function to update 
37148>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37148>>>>>    // the right records when this procedure is called.
37148>>>>>    //
37148>>>>>    // Params:
37148>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37148>>>>>    //
37148>>>>>    Procedure UpdateSessionProperties Boolean bClear
37150>>>>>        Handle hoUserDD
37150>>>>>        
37150>>>>>        Get phoUserDD to hoUserDD
37151>>>>>        
37151>>>>>        //  Update user properties
37151>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37153>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37154>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37155>>>>>            Set piUserRights to WebAppUser.Rights
37156>>>>>            
37156>>>>>            Send OnSessionPropertiesSet 
37157>>>>>        End
37157>>>>>>
37157>>>>>        Else Begin
37158>>>>>            Set psUsername to ""
37159>>>>>            Set psLoginName to ""
37160>>>>>            Set piUserRights to 0
37161>>>>>            
37161>>>>>            Send OnSessionPropertiesClear
37162>>>>>        End
37162>>>>>>
37162>>>>>    End_Procedure
37163>>>>>    
37163>>>>>    Procedure OnSessionPropertiesSet
37165>>>>>        //  Empty event stub
37165>>>>>    End_Procedure
37166>>>>>    
37166>>>>>    Procedure OnSessionPropertiesClear
37168>>>>>        //  Empty event stub
37168>>>>>    End_Procedure
37169>>>>>    
37169>>>>>    Procedure EndSession
37171>>>>>        Integer iErr
37171>>>>>        Boolean bLogWebSession
37171>>>>>        Handle hoSessionDD       
37171>>>>>        
37171>>>>>        Get phoSessionDD to hoSessionDD
37172>>>>>        Get pbLogWebSession to bLogWebSession
37173>>>>>        If not bLogWebSession Begin
37175>>>>>            Forward Send EndSession
37177>>>>>            Procedure_Return
37178>>>>>        End
37178>>>>>>
37178>>>>>            
37178>>>>>        //  Check if session exists
37178>>>>>        Send Clear of hoSessionDD
37179>>>>>        Get psSessionKey to WebAppSession.SessionKey
37180>>>>>        
37180>>>>>        Send Find of hoSessionDD EQ Index.1
37181>>>>>        If (Found) Begin
37183>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37184>>>>>            Get Request_Validate of hoSessionDD to iErr
37185>>>>>            If (iErr) Begin
37187>>>>>                // this should not happen. If it does its a programming error
37187>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37188>>>>>>
37188>>>>>                Procedure_Return
37189>>>>>            End
37189>>>>>>
37189>>>>>            Send Request_Save of hoSessionDD
37190>>>>>        End
37190>>>>>>
37190>>>>>    End_Procedure
37191>>>>>
37191>>>>>End_Class
