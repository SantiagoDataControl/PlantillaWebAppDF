37279>>>    Procedure DoLogin
37282>>>        String sLoginName sPassword sPrevStateHash
37282>>>        Boolean bResult
37282>>>        
37282>>>        WebGet psValue of oLoginName to sLoginName
37283>>>        WebGet psValue of oPassword to sPassword
37284>>>        
37284>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37285>>>        
37285>>>        If (bResult) Begin
37287>>>            Send Hide of oLogin
37288>>>            Send ShowHeader of ghoWebApp
37289>>>            WebSet psCSSClass of ghoWebApp to ""
37290>>>            
37290>>>            WebGet psPrevStateHash to sPrevStateHash
37291>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37292>>>            
37292>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37292>>>            WebSet psValue of oLoginName to ""
37293>>>            WebSet psValue of oPassword  to ""
37294>>>            WebSet pbVisible of oWarning to False
37295>>>        End
37295>>>>
37295>>>        Else Begin
37296>>>            WebSet pbVisible of oWarning to True
37297>>>        End
37297>>>>
37297>>>    End_Procedure
