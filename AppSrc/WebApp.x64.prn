36692>>>>>>>        Pointer pBase64
36692>>>>>>>        String sBase64
36692>>>>>>>        Move (Base64Encode(AddressOf(ucaBuffer), SizeOfArray(ucaBuffer))) to pBase64
36693>>>>>>>        If (not(pBase64)) Begin
36695>>>>>>>            Function_Return sBase64
36696>>>>>>>        End
36696>>>>>>>>
36696>>>>>>>        Move (PointerToString(pBase64)) to sBase64
36697>>>>>>>        Move (Free(pBase64)) to iErr
36698>>>>>>>        Function_Return sBase64
36699>>>>>>>    End_Function
36700>>>>>>>    
36700>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36702>>>>>>>        Integer iLen
36702>>>>>>>        Pointer pBase64
36702>>>>>>>        UChar[] ucaBuffer
36703>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36704>>>>>>>        If (not(pBase64)) Begin
36706>>>>>>>            Function_Return ucaBuffer
36707>>>>>>>        End
36707>>>>>>>>
36707>>>>>>>        
36707>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36708>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36709>>>>>>>        Move (Free(pBase64)) to iLen
36710>>>>>>>        Function_Return ucaBuffer
36711>>>>>>>    End_Function
36712>>>>>>>    
36712>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36714>>>>>>>        Boolean bOk bRequireTimeCost
36714>>>>>>>        UChar[] ucaHash
36715>>>>>>>        
36715>>>>>>>        Case Begin
36715>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36717>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36718>>>>>>>                If (not(bOk)) Function_Return False
36721>>>>>>>                
36721>>>>>>>                Move True to bRequireTimeCost
36722>>>>>>>                Case Break
36723>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36726>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36727>>>>>>>                If (not(bOk)) Function_Return False
36730>>>>>>>                
36730>>>>>>>                Move True to bRequireTimeCost
36731>>>>>>>                Case Break
36732>>>>>>>            Case Else
36732>>>>>>>                Error 8710 "Invalid algorithm selected."
36733>>>>>>>>
36733>>>>>>>                Function_Return False
36734>>>>>>>        Case End
36734>>>>>>>        
36734>>>>>>>        String sSalt
36734>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36735>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36738>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36739>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36742>>>>>>>        
36742>>>>>>>        If (bRequireTimeCost) Begin
36744>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36745>>>>>>>        End
36745>>>>>>>>
36745>>>>>>>        Else Begin
36746>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36747>>>>>>>        End
36747>>>>>>>>
36747>>>>>>>        
36747>>>>>>>        Function_Return bOk
36748>>>>>>>    End_Function
36749>>>>>>>    
36749>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36751>>>>>>>        UChar[] ucaSalt
36752>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36753>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36756>>>>>>>        
36756>>>>>>>        If (num_arguments > 4) Begin
36758>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36759>>>>>>>        End
36759>>>>>>>>
36759>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36760>>>>>>>    End_Function
36761>>>>>>>    
36761>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36763>>>>>>>        Boolean bRequiresTimeCost
36763>>>>>>>        UInteger uiAlgo uiTimeCost
36763>>>>>>>        Integer iBegin iEnd
36763>>>>>>>        String sSalt
36763>>>>>>>        
36763>>>>>>>        Move 1 to iBegin
36764>>>>>>>        
36764>>>>>>>        // Parse Algo
36764>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36765>>>>>>>        If (not(iEnd)) Function_Return False
36768>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36769>>>>>>>        
36769>>>>>>>        // Parse Salt
36769>>>>>>>        Move (iEnd + 1) to iBegin
36770>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36771>>>>>>>        If (not(iEnd)) Function_Return False
36774>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36775>>>>>>>        
36775>>>>>>>        Case Begin
36775>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36777>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36780>>>>>>>                Move True to bRequiresTimeCost
36781>>>>>>>                Case Break
36782>>>>>>>            Case Else
36782>>>>>>>                Error 8710 "Invalid algorithm selected."
36783>>>>>>>>
36783>>>>>>>                Function_Return False
36784>>>>>>>        Case End
36784>>>>>>>        
36784>>>>>>>        // Parse optional timecost
36784>>>>>>>        If (bRequiresTimeCost) Begin
36786>>>>>>>            Move (iEnd + 1) to iBegin
36787>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36788>>>>>>>            If (not(iEnd)) Function_Return False
36791>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36792>>>>>>>        End
36792>>>>>>>>
36792>>>>>>>        
36792>>>>>>>        // Parse rest hash
36792>>>>>>>        Move (iEnd + 1) to iBegin
36793>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36794>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36797>>>>>>>        
36797>>>>>>>        // Base64Decode
36797>>>>>>>        UChar[] ucaSalt
36798>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36799>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36802>>>>>>>        
36802>>>>>>>        // Create new hash
36802>>>>>>>        String sNewHash
36802>>>>>>>        If (bRequiresTimeCost) Begin
36804>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36806>>>>>>>                Function_Return False 
36807>>>>>>>            End
36807>>>>>>>>
36807>>>>>>>        End
36807>>>>>>>>
36807>>>>>>>        Else Begin
36808>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36810>>>>>>>                Function_Return False 
36811>>>>>>>            End
36811>>>>>>>>
36811>>>>>>>        End
36811>>>>>>>>
36811>>>>>>>        Function_Return (sNewHash = sHash)
36812>>>>>>>    End_Function
36813>>>>>>>    
36813>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36815>>>>>>>        Boolean bRequireTimeCost
36815>>>>>>>        UBigInt ullSize
36815>>>>>>>        UChar[] ucaSalt
36816>>>>>>>        String sSalt
36816>>>>>>>        
36816>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36817>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36818>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36821>>>>>>>        
36821>>>>>>>        Case Begin
36821>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36823>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36824>>>>>>>                Move True to bRequireTimeCost
36825>>>>>>>                Case Break
36826>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36829>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36830>>>>>>>                Move True to bRequireTimeCost
36831>>>>>>>                Case Break
36832>>>>>>>            Case Else
36832>>>>>>>                Error 8710 "Invalid algorithm selected."
36833>>>>>>>>
36833>>>>>>>                Function_Return 0
36834>>>>>>>        Case End
36834>>>>>>>        
36834>>>>>>>        // calculate base64 in a non-floating-manner
36834>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36835>>>>>>>        
36835>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36836>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36837>>>>>>>        If (bRequireTimeCost) Begin
36839>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36840>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36841>>>>>>>        End
36841>>>>>>>>
36841>>>>>>>        Else Begin
36842>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36843>>>>>>>        End
36843>>>>>>>>
36843>>>>>>>        
36843>>>>>>>        Function_Return ullSize
36844>>>>>>>    End_Function
36845>>>>>>>End_Class
36846>>>>>>>
36846>>>>>>>Class cPasswordHasher is a cObject
36847>>>>>>>    
36847>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36848>>>>>>>    
36848>>>>>>>    Procedure Construct_Object
36850>>>>>>>        Forward Send Construct_Object
36852>>>>>>>        
36852>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36853>>>>>>>        Property UInteger   puiSaltSize         16
36854>>>>>>>        
36854>>>>>>>        Property UInteger   puiOptTimeCost      420000
36855>>>>>>>    End_Procedure
36856>>>>>>>    
36856>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36858>>>>>>>        Boolean bOk
36858>>>>>>>        UInteger uiAlgo
36858>>>>>>>        Get peAlgorithm to uiAlgo
36859>>>>>>>        
36859>>>>>>>        Case Begin
36859>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36861>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36864>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36865>>>>>>>                Case Break
36866>>>>>>>            Case Else
36866>>>>>>>                Error 8710 "Invalid algorithm selected."
36867>>>>>>>>
36867>>>>>>>                Function_Return False
36868>>>>>>>        Case End
36868>>>>>>>        
36868>>>>>>>        Function_Return bOk
36869>>>>>>>    End_Function
36870>>>>>>>    
36870>>>>>>>    Function RequiredBufferSize Returns UBigInt
36872>>>>>>>        UBigInt ullSize
36872>>>>>>>        UInteger uiAlgo
36872>>>>>>>        Get peAlgorithm to uiAlgo
36873>>>>>>>        
36873>>>>>>>        Case Begin
36873>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36875>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36878>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36879>>>>>>>                Case Break
36880>>>>>>>            Case Else
36880>>>>>>>                Error 8710 "Invalid algorithm selected."
36881>>>>>>>>
36881>>>>>>>                Function_Return 0
36882>>>>>>>        Case End
36882>>>>>>>        
36882>>>>>>>        Function_Return ullSize
36883>>>>>>>    End_Function
36884>>>>>>>
36884>>>>>>>End_Class
