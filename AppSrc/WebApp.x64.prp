36697>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36699>>>>>>>        Boolean bOk bRequireTimeCost
36699>>>>>>>        UChar[] ucaHash
36700>>>>>>>        
36700>>>>>>>        Case Begin
