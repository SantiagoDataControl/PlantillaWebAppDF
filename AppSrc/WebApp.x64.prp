36702>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36703>>>>>>>                If (not(bOk)) Function_Return False
36706>>>>>>>                
36706>>>>>>>                Move True to bRequireTimeCost
36707>>>>>>>                Case Break
36708>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36711>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36712>>>>>>>                If (not(bOk)) Function_Return False
36715>>>>>>>                
36715>>>>>>>                Move True to bRequireTimeCost
36716>>>>>>>                Case Break
36717>>>>>>>            Case Else
36717>>>>>>>                Error 8710 "Invalid algorithm selected."
36718>>>>>>>>
36718>>>>>>>                Function_Return False
36719>>>>>>>        Case End
36719>>>>>>>        
36719>>>>>>>        String sSalt
