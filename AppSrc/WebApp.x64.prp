36734>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36736>>>>>>>        UChar[] ucaSalt
36737>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36738>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36741>>>>>>>        
36741>>>>>>>        If (num_arguments > 4) Begin
36743>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36744>>>>>>>        End
36744>>>>>>>>
36744>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36745>>>>>>>    End_Function
