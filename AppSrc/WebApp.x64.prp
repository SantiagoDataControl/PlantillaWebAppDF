36895>>>>>        Forward Send End_Construct_Object
36897>>>>>        
36897>>>>>        Handle hoCrypto
36897>>>>>        Integer iFieldLen
36897>>>>>        If (pbPasswordHashing(Self)) Begin
36899>>>>>            Get phoCrypto to hoCrypto
36900>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36903>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36905>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36906>>>>>>
36906>>>>>            End
36906>>>>>>
36906>>>>>        End
36906>>>>>>
36906>>>>>    End_Procedure
36907>>>>>    
36907>>>>>    Function CreateSession String sRemoteAddress Returns String
36909>>>>>        String sSessionKey
36909>>>>>        Integer iErr
36909>>>>>        Boolean bLogWebSession
36909>>>>>        Handle hoSessionDD       
36909>>>>>        Get phoSessionDD to hoSessionDD
36910>>>>>        
36910>>>>>        //  Get session key
36910>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36912>>>>>        
36912>>>>>        Get pbLogWebSession to bLogWebSession
36913>>>>>        If not bLogWebSession Begin
36915>>>>>            Function_Return sSessionKey        
36916>>>>>        End
36916>>>>>>
36916>>>>>
36916>>>>>        //  Store session
36916>>>>>        Send Clear of hoSessionDD
36917>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36918>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36919>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36920>>>>>        Get Request_Validate of hoSessionDD to iErr
36921>>>>>        If (iErr) Begin
36923>>>>>            // this should not happen. If it does its a programming error
36923>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36924>>>>>>
36924>>>>>            Function_Return ""
36925>>>>>        End
36925>>>>>>
36925>>>>>        Send Request_Save of hoSessionDD
36926>>>>>        If (Err) Begin
36928>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36928>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36929>>>>>>
36929>>>>>            Function_Return ""
36930>>>>>        End
36930>>>>>>
36930>>>>>       
36930>>>>>        Function_Return sSessionKey        
36931>>>>>    End_Function
36932>>>>>    
36932>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36934>>>>>        DateTime dtLastAccess dtCurrent
36934>>>>>        TimeSpan tsDiff
36934>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36934>>>>>        Boolean bResult bCreatingNewSession
36934>>>>>        Boolean bLogWebSession bLoadWebApp
36934>>>>>        Integer eLoginMode
36934>>>>>        String sTime
36934>>>>>        Handle hoSessionDD hoUserDD       
36934>>>>>        
36934>>>>>        Move False to bLoadWebApp
36935>>>>>        If (num_arguments >= 2) Begin
36937>>>>>            Move bOptLoadWebApp to bLoadWebApp
36938>>>>>        End
36938>>>>>>
36938>>>>>        
36938>>>>>        Get phoSessionDD to hoSessionDD
36939>>>>>        Get phoUserDD to hoUserDD
36940>>>>>        
36940>>>>>        Get pbLogWebSession to bLogWebSession
36941>>>>>        Get peLoginMode to eLoginMode
36942>>>>>        
36942>>>>>        // for this object, you can only disable logging if login completely is disabled
36942>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36944>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36945>>>>>>
36945>>>>>            Function_Return False
36946>>>>>        End
36946>>>>>>
36946>>>>>
36946>>>>>        //  Clear session properties
36946>>>>>        Set psSessionKey to ""
36947>>>>>        Send UpdateSessionProperties True
36948>>>>>        
36948>>>>>        If not bLogWebSession Begin
36950>>>>>            Forward Get ValidateSession sSessionKey to bResult
36952>>>>>            Function_Return bResult
36953>>>>>        End        
36953>>>>>>
36953>>>>>        
36953>>>>>        Move False to bResult
36954>>>>>        Get piSessionTimeout to iSessionTimeout 
36955>>>>>        
36955>>>>>        //  Check if session exists
36955>>>>>        Send Clear of hoSessionDD
36956>>>>>        Move sSessionKey to WebAppSession.SessionKey
36957>>>>>        Send Find of hoSessionDD EQ Index.1
36958>>>>>            
36958>>>>>        If (Found) Begin
36960>>>>>            //  Calculate timespan between now and last access time
36960>>>>>            Move (CurrentDateTime()) to dtCurrent
36961>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36962>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36963>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36964>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36965>>>>>            
36965>>>>>            //  Check if session didn't time out
36965>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36967>>>>>                Forward Get ValidateSession sSessionKey to bResult
36969>>>>>                   
36969>>>>>                If (bResult) Begin
36971>>>>>                    //  Update session record
36971>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36972>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36973>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36974>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36975>>>>>                    Get Request_Validate of hoSessionDD to iErr
36976>>>>>                    If (iErr) Begin
36978>>>>>                        // this should not happen. If it does its a programming error
36978>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36979>>>>>>
36979>>>>>                        Function_Return False
36980>>>>>                    End
36980>>>>>>
36980>>>>>                    Send Request_Save of hoSessionDD
36981>>>>>                    
36981>>>>>                    //  Update user properties
36981>>>>>                    Send UpdateSessionProperties False
36982>>>>>                End
36982>>>>>>
36982>>>>>            End
36982>>>>>>
36982>>>>>            Else Begin
36983>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36983>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36984>>>>>                
36984>>>>>                If (not(bCreatingNewSession)) Begin
36986>>>>>                    If (not(bLoadWebApp)) Begin
36988>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36989>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36990>>>>>>
36990>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36991>>>>>                    End
36991>>>>>>
36991>>>>>                    Else Begin
36992>>>>>                        Set pbCreatingNewSession to True                    
36993>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36994>>>>>                        Set pbCreatingNewSession to False                        
36995>>>>>                    End
36995>>>>>>
36995>>>>>                End
36995>>>>>>
36995>>>>>            End
36995>>>>>>
36995>>>>>        End
36995>>>>>>
36995>>>>>        Else Begin
36996>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36997>>>>>>
36997>>>>>        End
36997>>>>>>
36997>>>>>        
36997>>>>>        Function_Return bResult
36998>>>>>    End_Function
36999>>>>>    
36999>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37001>>>>>        If (not(pbPasswordHashing(Self))) Begin
37003>>>>>            Move sPassword to sHash
37004>>>>>            Function_Return True
37005>>>>>        End
37005>>>>>>
37005>>>>>        
37005>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37007>>>>>            Function_Return False
37008>>>>>        End
37008>>>>>>
37008>>>>>        Move ("V1$" + sHash) to sHash
37009>>>>>        Function_Return True
37010>>>>>    End_Function
37011>>>>>    
37011>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37013>>>>>        If (not(pbPasswordHashing(Self))) Begin
37015>>>>>            Move False to bShouldUpgrade
37016>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37017>>>>>        End
37017>>>>>>
37017>>>>>        
37017>>>>>        String sVersion
37017>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37018>>>>>        If (sVersion = "V1$") Begin
37020>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37023>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37024>>>>>        End
37024>>>>>>
37024>>>>>        Else Begin
37025>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37028>>>>>            Function_Return False
37029>>>>>        End
37029>>>>>>
37029>>>>>    End_Function
37030>>>>>    
37030>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37032>>>>>        Handle hoUserDD
37032>>>>>        Integer iErr
37032>>>>>        Get phoUserDD to hoUserDD
37033>>>>>        
37033>>>>>        //  Find the user
37033>>>>>        Send Clear of hoUserDD
37034>>>>>        Move sLoginName to WebAppUser.LoginName
37035>>>>>        Send Find of hoUserDD EQ Index.1
37036>>>>>        If (Found) Begin
37038>>>>>            Send Clear of hoUserDD
37039>>>>>            Function_Return False
37040>>>>>        End
37040>>>>>>
37040>>>>>        
37040>>>>>        Send Clear of hoUserDD
37041>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37042>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37043>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37045>>>>>            Send Clear of hoUserDD
37046>>>>>            Function_Return False
37047>>>>>        End
37047>>>>>>
37047>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37048>>>>>        Get Request_Validate of hoUserDD to iErr
37049>>>>>        If (iErr) Begin
37051>>>>>            Send Clear of hoUserDD
37052>>>>>            Function_Return False
37053>>>>>        End
37053>>>>>>
37053>>>>>        
37053>>>>>        Send Request_Save of hoUserDD
37054>>>>>        Function_Return (not(Err))
37055>>>>>    End_Function
37056>>>>>    
37056>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37058>>>>>        String sSessionKey sUserPassword
37058>>>>>        Handle hoSessionDD hoUserDD
37058>>>>>        Boolean bMatch bUpgrade
37058>>>>>        
37058>>>>>        Get phoSessionDD to hoSessionDD
37059>>>>>        Get phoUserDD to hoUserDD
37060>>>>>        Integer iErr eLoginMode
37060>>>>>        
37060>>>>>        // Refind session record
37060>>>>>        Get psSessionKey to sSessionKey
37061>>>>>        Send Clear of hoSessionDD
37062>>>>>        Move sSessionKey to WebAppSession.SessionKey
37063>>>>>        Send Find of hoSessionDD EQ Index.1
37064>>>>>        
37064>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37066>>>>>            Get peLoginMode to eLoginMode
37067>>>>>            
37067>>>>>            //  Find the user
37067>>>>>            Move sLoginName to WebAppUser.LoginName
37068>>>>>            Send Find of hoUserDD EQ Index.1
37069>>>>>            
37069>>>>>            // Check username and password
37069>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37071>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37072>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37073>>>>>                
37073>>>>>                If (bMatch) Begin
37075>>>>>                    // Store the login
37075>>>>>                    If (bUpgrade) Begin
37077>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37078>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37081>>>>>                    End
37081>>>>>>
37081>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37082>>>>>                    Get Request_Validate of hoSessionDD to iErr
37083>>>>>                    If (iErr) Begin
37085>>>>>                        // this should not happen. If it does its a programming error
37085>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37086>>>>>>
37086>>>>>                        Function_Return False
37087>>>>>                    End
37087>>>>>>
37087>>>>>                    
37087>>>>>                    Send Request_Save of hoSessionDD
37088>>>>>                    
37088>>>>>                    // Update session properties
37088>>>>>                    Send UpdateSessionProperties False
37089>>>>>                    Send NotifyChangeRights
37090>>>>>                    Function_Return True
37091>>>>>                End
37091>>>>>>
37091>>>>>                Else Begin
37092>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37092>>>>>                    Send Clear of hoUserDD
37093>>>>>                End
37093>>>>>>
37093>>>>>            End
37093>>>>>>
37093>>>>>            Else Begin
37094>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37094>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37095>>>>>            End
37095>>>>>>
37095>>>>>        End
37095>>>>>>
37095>>>>>        Else Begin
37096>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37096>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37097>>>>>        End
37097>>>>>>
37097>>>>>          
37097>>>>>        Function_Return False
37098>>>>>    End_Function
37099>>>>>    
37099>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37101>>>>>        Handle hoUserDD
37101>>>>>        Integer iErr
37101>>>>>        Get phoUserDD to hoUserDD
37102>>>>>        
37102>>>>>        //  Find the user
37102>>>>>        Send Clear of hoUserDD
37103>>>>>        Move sLoginName to WebAppUser.LoginName
37104>>>>>        Send Find of hoUserDD EQ Index.1
37105>>>>>        If (not(Found)) Begin
37107>>>>>            Send Clear of hoUserDD
37108>>>>>            Function_Return False
37109>>>>>        End
37109>>>>>>
37109>>>>>        
37109>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37111>>>>>            Send Clear of hoUserDD
37112>>>>>            Function_Return False
37113>>>>>        End
37113>>>>>>
37113>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37114>>>>>        Get Request_Validate of hoUserDD to iErr
37115>>>>>        If (iErr) Begin
37117>>>>>            Send Clear of hoUserDD
37118>>>>>            Function_Return False
37119>>>>>        End
37119>>>>>>
37119>>>>>        
37119>>>>>        Send Request_Save of hoUserDD
37120>>>>>        Function_Return (not(Err))
37121>>>>>    End_Function
37122>>>>>    
37122>>>>>    Function IsLoggedIn Returns Boolean
37124>>>>>        String sLoginName
37124>>>>>        Boolean bLogWebSession bLoggedIn
37124>>>>>        
37124>>>>>        Get pbLogWebSession to bLogWebSession
37125>>>>>        If not bLogWebSession Begin
37127>>>>>            Forward Get IsLoggedIn to bLoggedIn
37129>>>>>            Function_Return bLoggedIn
37130>>>>>        End
37130>>>>>>
37130>>>>>        
37130>>>>>        Get psLoginName to sLoginName
37131>>>>>        
37131>>>>>        Function_Return (sLoginName <> "")
37132>>>>>    End_Function
37133>>>>>    
37133>>>>>    
37133>>>>>    //
37133>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37133>>>>>    // update properties based on the session and user data. Augment this function to update 
37133>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37133>>>>>    // the right records when this procedure is called.
37133>>>>>    //
37133>>>>>    // Params:
37133>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37133>>>>>    //
37133>>>>>    Procedure UpdateSessionProperties Boolean bClear
37135>>>>>        Handle hoUserDD
37135>>>>>        
37135>>>>>        Get phoUserDD to hoUserDD
37136>>>>>        
37136>>>>>        //  Update user properties
37136>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37138>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37139>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37140>>>>>            Set piUserRights to WebAppUser.Rights
37141>>>>>            
37141>>>>>            Send OnSessionPropertiesSet 
37142>>>>>        End
37142>>>>>>
37142>>>>>        Else Begin
37143>>>>>            Set psUsername to ""
37144>>>>>            Set psLoginName to ""
37145>>>>>            Set piUserRights to 0
37146>>>>>            
37146>>>>>            Send OnSessionPropertiesClear
37147>>>>>        End
37147>>>>>>
37147>>>>>    End_Procedure
37148>>>>>    
37148>>>>>    Procedure OnSessionPropertiesSet
37150>>>>>        //  Empty event stub
37150>>>>>    End_Procedure
37151>>>>>    
37151>>>>>    Procedure OnSessionPropertiesClear
37153>>>>>        //  Empty event stub
37153>>>>>    End_Procedure
37154>>>>>    
37154>>>>>    Procedure EndSession
37156>>>>>        Integer iErr
37156>>>>>        Boolean bLogWebSession
37156>>>>>        Handle hoSessionDD       
37156>>>>>        
37156>>>>>        Get phoSessionDD to hoSessionDD
37157>>>>>        Get pbLogWebSession to bLogWebSession
37158>>>>>        If not bLogWebSession Begin
37160>>>>>            Forward Send EndSession
37162>>>>>            Procedure_Return
37163>>>>>        End
37163>>>>>>
37163>>>>>            
37163>>>>>        //  Check if session exists
37163>>>>>        Send Clear of hoSessionDD
37164>>>>>        Get psSessionKey to WebAppSession.SessionKey
37165>>>>>        
37165>>>>>        Send Find of hoSessionDD EQ Index.1
37166>>>>>        If (Found) Begin
37168>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37169>>>>>            Get Request_Validate of hoSessionDD to iErr
37170>>>>>            If (iErr) Begin
37172>>>>>                // this should not happen. If it does its a programming error
37172>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37173>>>>>>
37173>>>>>                Procedure_Return
37174>>>>>            End
37174>>>>>>
37174>>>>>            Send Request_Save of hoSessionDD
37175>>>>>        End
37175>>>>>>
37175>>>>>    End_Procedure
37176>>>>>
37176>>>>>End_Class
