37264>>>    Procedure DoLogin
37267>>>        String sLoginName sPassword sPrevStateHash
37267>>>        Boolean bResult
37267>>>        
37267>>>        WebGet psValue of oLoginName to sLoginName
37268>>>        WebGet psValue of oPassword to sPassword
37269>>>        
37269>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37270>>>        
37270>>>        If (bResult) Begin
37272>>>            Send Hide of oLogin
37273>>>            Send ShowHeader of ghoWebApp
37274>>>            WebSet psCSSClass of ghoWebApp to ""
37275>>>            
37275>>>            WebGet psPrevStateHash to sPrevStateHash
37276>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37277>>>            
37277>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37277>>>            WebSet psValue of oLoginName to ""
37278>>>            WebSet psValue of oPassword  to ""
37279>>>            WebSet pbVisible of oWarning to False
37280>>>        End
37280>>>>
37280>>>        Else Begin
37281>>>            WebSet pbVisible of oWarning to True
37282>>>        End
37282>>>>
37282>>>    End_Procedure
37283>>>    
