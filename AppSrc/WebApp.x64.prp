36720>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36723>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36724>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36727>>>>>>>        
36727>>>>>>>        If (bRequireTimeCost) Begin
36729>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36730>>>>>>>        End
36730>>>>>>>>
36730>>>>>>>        Else Begin
36731>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36732>>>>>>>        End
36732>>>>>>>>
36732>>>>>>>        
36732>>>>>>>        Function_Return bOk
36733>>>>>>>    End_Function
