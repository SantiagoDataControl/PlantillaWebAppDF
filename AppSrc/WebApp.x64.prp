36746>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36748>>>>>>>        Boolean bRequiresTimeCost
36748>>>>>>>        UInteger uiAlgo uiTimeCost
36748>>>>>>>        Integer iBegin iEnd
36748>>>>>>>        String sSalt
36748>>>>>>>        
36748>>>>>>>        Move 1 to iBegin
36749>>>>>>>        
36749>>>>>>>        // Parse Algo
36749>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36750>>>>>>>        If (not(iEnd)) Function_Return False
36753>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36754>>>>>>>        
36754>>>>>>>        // Parse Salt
36754>>>>>>>        Move (iEnd + 1) to iBegin
36755>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36756>>>>>>>        If (not(iEnd)) Function_Return False
36759>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36760>>>>>>>        
36760>>>>>>>        Case Begin
36760>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36762>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36765>>>>>>>                Move True to bRequiresTimeCost
36766>>>>>>>                Case Break
36767>>>>>>>            Case Else
36767>>>>>>>                Error 8710 "Invalid algorithm selected."
36768>>>>>>>>
36768>>>>>>>                Function_Return False
36769>>>>>>>        Case End
36769>>>>>>>        
36769>>>>>>>        // Parse optional timecost
36769>>>>>>>        If (bRequiresTimeCost) Begin
36771>>>>>>>            Move (iEnd + 1) to iBegin
36772>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36773>>>>>>>            If (not(iEnd)) Function_Return False
36776>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36777>>>>>>>        End
36777>>>>>>>>
36777>>>>>>>        
36777>>>>>>>        // Parse rest hash
36777>>>>>>>        Move (iEnd + 1) to iBegin
36778>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36779>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36782>>>>>>>        
36782>>>>>>>        // Base64Decode
36782>>>>>>>        UChar[] ucaSalt
36783>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36784>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36787>>>>>>>        
36787>>>>>>>        // Create new hash
36787>>>>>>>        String sNewHash
36787>>>>>>>        If (bRequiresTimeCost) Begin
36789>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36791>>>>>>>                Function_Return False 
36792>>>>>>>            End
36792>>>>>>>>
36792>>>>>>>        End
36792>>>>>>>>
36792>>>>>>>        Else Begin
36793>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36795>>>>>>>                Function_Return False 
36796>>>>>>>            End
36796>>>>>>>>
36796>>>>>>>        End
36796>>>>>>>>
36796>>>>>>>        Function_Return (sNewHash = sHash)
36797>>>>>>>    End_Function
36798>>>>>>>    
36798>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36800>>>>>>>        Boolean bRequireTimeCost
36800>>>>>>>        UBigInt ullSize
36800>>>>>>>        UChar[] ucaSalt
36801>>>>>>>        String sSalt
36801>>>>>>>        
36801>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36802>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36803>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36806>>>>>>>        
36806>>>>>>>        Case Begin
36806>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36808>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36809>>>>>>>                Move True to bRequireTimeCost
36810>>>>>>>                Case Break
36811>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36814>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36815>>>>>>>                Move True to bRequireTimeCost
36816>>>>>>>                Case Break
36817>>>>>>>            Case Else
36817>>>>>>>                Error 8710 "Invalid algorithm selected."
36818>>>>>>>>
36818>>>>>>>                Function_Return 0
36819>>>>>>>        Case End
36819>>>>>>>        
36819>>>>>>>        // calculate base64 in a non-floating-manner
36819>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36820>>>>>>>        
36820>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36821>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36822>>>>>>>        If (bRequireTimeCost) Begin
36824>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36825>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36826>>>>>>>        End
36826>>>>>>>>
36826>>>>>>>        Else Begin
36827>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36828>>>>>>>        End
36828>>>>>>>>
36828>>>>>>>        
36828>>>>>>>        Function_Return ullSize
36829>>>>>>>    End_Function
36830>>>>>>>End_Class
