36556>>>>>>>    //
36556>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36556>>>>>>>    //
36556>>>>>>>    //  Params:
36556>>>>>>>    //      dtTime  Time to convert
36556>>>>>>>    //  Returns:
36556>>>>>>>    //      String with "HH:MM:SS" format
36556>>>>>>>    //
36556>>>>>>>    Function TimeToString DateTime dtTime Returns String
36558>>>>>>>        String sHours sMinutes sSeconds
36558>>>>>>>        
36558>>>>>>>        //  Extract parts
36558>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36559>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36560>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36561>>>>>>>        
36561>>>>>>>        //  Fill out with 0
36561>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36564>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36567>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36570>>>>>>>        
36570>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36571>>>>>>>    End_Function
36572>>>>>>>    
36572>>>>>>>    //
36572>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36572>>>>>>>    //
36572>>>>>>>    //  Params:
36572>>>>>>>    //      dtTime  Datetime variable to add time to
36572>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36572>>>>>>>    //  Returns:
36572>>>>>>>    //      dtDateTime with the loaded time
36572>>>>>>>    //
36572>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36574>>>>>>>        String sHours sMinutes sSeconds
36574>>>>>>>        
36574>>>>>>>        //  Extract parts
36574>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36575>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36576>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36577>>>>>>>        
36577>>>>>>>        //  Set to DateTime
36577>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36578>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36579>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36580>>>>>>>        
36580>>>>>>>        Function_Return dtTime
36581>>>>>>>    End_Function
