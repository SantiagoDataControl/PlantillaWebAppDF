37288>>>    Procedure OnLoad
37291>>>        String sPrevStateHash sView
37291>>>        
37291>>>        Forward Send OnLoad
37293>>>        
37293>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37293>>>        Get StateHash of ghoWebApp to sPrevStateHash
37294>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37295>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37297>>>            WebSet psPrevStateHash to sPrevStateHash
37298>>>        End
37298>>>>
37298>>>        
37298>>>    End_Procedure
